{
  "schema_version": 1,
  "scope": "phase-17-production-validation",
  "provider_target": "conoha-vps-primary",
  "validation_mode": "trial-production-conoha-vps",
  "operation_steps": [
    "operation-start",
    "monitor",
    "issue-detect",
    "spec-general-update",
    "implementation-fix",
    "redeploy",
    "revalidate",
    "evidence-record",
    "known-bug-zero-check"
  ],
  "operation_window": "initial-production-validation",
  "monitor_interval_seconds": 0,
  "required_monitor_sample_count": 1,
  "max_consecutive_monitor_failures": 0,
  "abort_conditions": [
    "secret-boundary-failure",
    "destructive-operation-boundary-failure",
    "state-corruption",
    "service-unrecoverable",
    "known-critical-bug"
  ],
  "bugfix_spec_first_required": true,
  "revalidation_required": true,
  "known_bug_zero_required": true
}
