{
  "schema_version": 1,
  "scope": "phase-17-production-validation",
  "provider_target": "conoha-vps-primary",
  "validation_mode": "trial-production-conoha-vps",
  "required_check": "phase17-security-boundary",
  "secret_classes": [
    "provider-token",
    "admin-token",
    "ssh-private-key",
    "ip-specific-secret",
    "host-specific-secret"
  ],
  "allowed_secret_input_channels": [
    "operator-local-file",
    "operator-stdin",
    "ssh-agent",
    "systemd-credential",
    "not-required"
  ],
  "forbidden_secret_input_channels": [
    "repository-file",
    "fixture-file",
    "command-argument",
    "environment-variable",
    "pr-body",
    "issue-comment",
    "chat-message",
    "stdout",
    "stderr",
    "log",
    "screen-shot"
  ],
  "credential_storage_policy": "repository-forbidden",
  "secret_reference_policy": "metadata-only",
  "destructive_operation_boundaries": [
    "vps-create",
    "vps-delete",
    "plan-change",
    "disk-rebuild",
    "volume-create",
    "volume-delete",
    "volume-attach",
    "volume-detach",
    "firewall-lockout",
    "ssh-lockout"
  ],
  "mask_required": true
}
