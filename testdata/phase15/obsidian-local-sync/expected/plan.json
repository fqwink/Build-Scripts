{
  "conflict_dir": "adlaire-ci-conflicts",
  "conflict_dir_default": "adlaire-ci-conflicts",
  "conflicts": [],
  "delete_policy": "tombstone",
  "direction": "bidirectional",
  "operations": [
    {
      "destination": "vault",
      "op": "create",
      "path": "docs/project.md",
      "rollback_required": true,
      "source": "project"
    },
    {
      "destination": "project",
      "op": "create",
      "path": "docs/vault.md",
      "rollback_required": true,
      "source": "vault"
    },
    {
      "destination": "vault",
      "op": "update",
      "path": "shared.md",
      "rollback_required": true,
      "source": "project"
    }
  ],
  "schema_version": "obsidian-sync-plan-v1",
  "tombstone_dir": "adlaire-ci-tombstones",
  "tombstone_dir_default": "adlaire-ci-tombstones",
  "tombstones": []
}
